# ==========================================
# keluhkampus - Environment Variables
# Copy file ini ke .env.local dan isi nilainya
# ==========================================

# Database PostgreSQL (JKC cPanel)
# Buat database dulu di cPanel → PostgreSQL Databases
DATABASE_URL="postgresql://DBUSER:DBPASS@localhost:5432/DBNAME?schema=public"
DIRECT_URL="postgresql://DBUSER:DBPASS@localhost:5432/DBNAME?schema=public"

# Auth JWT
# Generate dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_JWT_SECRET="REPLACE-WITH-RANDOM-BASE64-32"
AUTH_COOKIE_NAME="keluhkampus_session"
AUTH_COOKIE_SECURE="true"

# AI (OpenAI-compatible)
AI_API_KEY="sk-..."
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-5.5"
AI_MODEL_FAST="gpt-5-mini"
AI_MODEL_REVIEW="gpt-5.5"
AI_REPORT_TIMEOUT_MS="25000"

# File upload (path absolut di server JKC)
UPLOAD_DIR="/home/USERNAME/keluhkampus.my.id/uploads"
MAX_UPLOAD_BYTES="12582912"

# Reference cache admin (opsional)
REFERENCE_CACHE_ADMIN_TOKEN=""

# Python (untuk fix-format DOCX, kalau ada di JKC)
PYTHON_EXECUTABLE=""
