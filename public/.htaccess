# ============================================================================
# Apache .htaccess untuk keluhkampus.my.id
# -----------------------------------------------------------------------------
# Letakkan file ini di:
#   - public_html/.htaccess    (domain utama keluhkampus.my.id)
#   - public_html/subdomain/.htaccess  (kalau pakai subdomain)
#
# CARA KERJA:
#   Apache terima request di :80/:443 → forward ke Node.js di :3000 (loopback).
#   Reverse proxy pakai mod_proxy (aktifkan di Apache config JKC).
#
# PRASYARAT:
#   - mod_proxy, mod_proxy_http enabled di Apache
#     (kalau tidak, minta support JKC untuk enable).
#   - Node.js App sudah running di port 3000 (lihat server.js + cPanel Node App).
#
# TESTING:
#   curl -I https://keluhkampus.my.id/
#   curl https://keluhkampus.my.id/api/auth/me
#
# CATATAN:
#   - Block sensitif file (.env, package.json, .git) supaya tidak ke-expose.
#   - Cache static assets 1 tahun (Next.js kasih content-hash di filename).
#   - Kompresi gzip untuk response besar.
# ============================================================================

# --- Reverse proxy ke Node.js ---
RewriteEngine On

# Skip proxy untuk well-known paths (SSL verification, dll) — biar Apache tangani langsung.
RewriteCond %{REQUEST_URI} !^/\.well-known/

# Forward semua request ke Node.js app di localhost:3000.
# Flag [P] = proxy (butuh mod_proxy), [L] = last rule.
RewriteRule ^(.*)$ http://localhost:3000/$1 [P,L]

# --- Cache headers untuk static assets ---
<IfModule mod_expires.c>
  ExpiresActive On
  # JS, CSS — 1 tahun (Next.js filename sudah ada content-hash, safe to cache long).
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  # Images — 1 tahun.
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  # Fonts — 1 tahun.
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Gzip compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml application/xml+rss
</IfModule>

# --- Disable server signature (anti info disclosure) ---
ServerSignature Off

# --- Block akses ke file sensitif ---
# Tangkal kebocoran .env, package.json, .git lewat web.
<FilesMatch "^\.env|^\.env\.|package\.json|package-lock\.json|yarn\.lock|^\.git">
  Require all denied
</FilesMatch>

# --- Block dotfiles (hidden files) ---
<FilesMatch "^\.">
  Require all denied
</FilesMatch>